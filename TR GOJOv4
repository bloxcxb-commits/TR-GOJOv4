        DstToggle.Text = "⚠  Önce Mastery Türü Seç!"
        task.delay(2, function()
            DstToggle.Text = masteryRunning and "■  Destek Durdur" or "▶  Destek Başlat"
        end)
        return
    end

    -- Deniz kontrolü
    local sea, _ = detectSea()
    if not sea then
        DstToggle.Text = "⚠  Sea 2/3 değilsin!"
        task.delay(2.5, function()
            DstToggle.Text = masteryRunning and "■  Destek Durdur" or "▶  Destek Başlat"
        end)
        return
    end

    masteryRunning = not masteryRunning

    if masteryRunning then
        DstToggle.Text = "■  Destek Durdur"
        makeTween(DstToggle, {BackgroundColor3 = Color3.fromRGB(160, 15, 15)}, 0.2):Play()
        task.spawn(masteryLoop)
    else
        DstToggle.Text = "▶  Destek Başlat"
        makeTween(DstToggle, {BackgroundColor3 = Color3.fromRGB(50, 10, 10)}, 0.2):Play()
    end
end)

DstToggle.MouseEnter:Connect(function()
    if not masteryRunning then
        makeTween(DstToggle, {BackgroundColor3 = Color3.fromRGB(90, 12, 12)}, 0.1):Play()
    end
end)
