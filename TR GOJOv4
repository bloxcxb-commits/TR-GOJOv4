-- Kategori seçildiğinde hangi weapon/style aranacak
-- Kullanıcı seçimine göre State güncelle
local function onCategorySelect(cat)
    selectedCategory = cat
    -- Gun seçildiyse Gun isimli tool ara; diğerleri için uygun keyword
    if cat == "Gun" then
        -- Destek modu zaten Gun mastery için → gun equip = gun keyword'lerden biri
        selectedGunName = nil  -- otomatik tarama
        selectedMeleeStyle = nil
    elseif cat == "Sword" then
        -- Sword kasıyorsa: Sword = gun gibi düşün, melee = softener
        -- Bu modda "gun" yerine sword kullanılır, mantık aynı
        selectedGunName = nil  -- sword keyword eklenecek
        selectedMeleeStyle = nil
        -- Sword keywordleri GUN_KEYWORDS'e ekle (geçici)
        table.insert(GUN_KEYWORDS, "sword")
        table.insert(GUN_KEYWORDS, "katana")
        table.insert(GUN_KEYWORDS, "pole")
        table.insert(GUN_KEYWORDS, "dual")
    elseif cat == "Melee" then
        -- Melee kasıyorsa: softener = herhangi bir şey, final = melee
        -- Mantık tersine çevrilir: 90% başka bir şeyle, %10 melee ile
        selectedMeleeStyle = nil
        selectedGunName    = nil
        warn("[TRGojo] Melee mastery modu: softener otomatik seçilir, final = melee")
    elseif cat == "Fruits" then
        -- Fruit mastery benzer mantık
        warn("[TRGojo] Fruit mastery: Fruits equipped iken son vuruş fruit olacak")
    end
end

-- Category butonlarına onCategorySelect bağla (mevcut click handler'ın üstüne)
for cat, cb in pairs(categoryBtns) do
    cb.MouseButton1Click:Connect(function()
        onCategorySelect(cat)
    end)
end

