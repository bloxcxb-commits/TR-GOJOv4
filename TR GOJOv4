-- ================================================================
-- YARDIMCI FONKSİYONLAR
-- ================================================================

local function getCharacter()
    return LP.Character
end

local function getHRP()
    local c = getCharacter()
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid()
    local c = getCharacter()
    return c and c:FindFirstChildWhichIsA("Humanoid")
end

-- Karakter yüzünü NPC'ye çevir
local function faceTarget(targetHRP)
    local hrp = getHRP()
    if hrp and targetHRP then
        local dir = (targetHRP.Position - hrp.Position) * Vector3.new(1, 0, 1)
        hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + dir)
    end
end

-- Aracı backpack/characterdan bul ve kuşan
local function equipTool(keyword)
    local char = getCharacter()
    if not char then return nil end
    -- Zaten ellinde mi?
    for _, t in pairs(char:GetChildren()) do
        if t:IsA("Tool") and t.Name:lower():find(keyword:lower()) then
            return t
        end
    end
    -- Backpack'te ara
    for _, t in pairs(LP.Backpack:GetChildren()) do
        if t:IsA("Tool") and t.Name:lower():find(keyword:lower()) then
            char:WaitForChild("Humanoid"):EquipTool(t)
            task.wait(0.3)
            return t
        end
    end
    return nil
end

-- Seçilen fighting style'ı bul (melee = adına göre)
-- Blox Fruits'te fighting styles Tool olarak gözükür (Superhuman, Death Step vs.)
local MELEE_KEYWORDS = {
    "superhuman","death step","electric","sharkman","fishman",
    "dark step","water kung fu","ice kung fu","dragon","godhuman","sanguine art",
    "fighting style","melee","combat","black leg","electric claw"
}
local GUN_KEYWORDS = {
    "musket","rifle","cannon","bazooka","gun","slingshot","gatling",
    "dark_dagger","acidum rifle","soul guitar","pistol"
}

local function equipMelee(forceName)
    if forceName then
        return equipTool(forceName)
    end
    for _, kw in ipairs(MELEE_KEYWORDS) do
        local t = equipTool(kw)
        if t then return t end
    end
    return nil
end

local function equipGun(forceName)
    if forceName then
        return equipTool(forceName)
    end
    for _, kw in ipairs(GUN_KEYWORDS) do
        local t = equipTool(kw)
        if t then return t end
    end
    return nil
end

-- M1 simüle et (VIM + mouse click fallback)
local function doM1()
    local hrp = getHRP()
    if not hrp then return end
    -- Mouse konumunu NPC'ye yönlendir (zaten faceTarget sonrası)
    local ok, err = pcall(function()
        VirtualInputManager:SendMouseButtonEvent(
            Mouse.X, Mouse.Y, 0, true, game, 0)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(
            Mouse.X, Mouse.Y, 0, false, game, 0)
    end)
    if not ok then
        -- Fallback: UserInputService sim
        pcall(function()
            local ev = Instance.new("InputObject")
            ev.KeyCode = Enum.KeyCode.Unknown
            ev.UserInputType = Enum.UserInputType.MouseButton1
            ev.UserInputState = Enum.UserInputState.Begin
        end)
    end
end

-- ================================================================
-- DENİZ TESPİTİ (Sea 2 / Sea 3)
-- ================================================================
-- Sea 2 Forgotten Island : Mythological Pirate, Sea Soldier, Water Fighter (Lv 1700-1850)
-- Sea 3 Castle on the Sea: Demonic Soul (Lv 2325), Possessed Mummy (Lv 2375)

local SEA2_NPCS = {"Mythological", "Sea Soldier", "Water Fighter", "Tide"}
local SEA3_NPCS = {"Demonic Soul", "Demonic", "Possessed Mummy", "Possessed", "Mummy"}

local function detectSea()
    local hrp = getHRP()
    if not hrp then return nil end

    local searchRadius = 800

    for _, desc in pairs(workspace:GetDescendants()) do
        if desc:IsA("Humanoid") and desc.Health > 0 then
            local enemyModel = desc.Parent
            if enemyModel and enemyModel ~= getCharacter() then
                local eHRP = enemyModel:FindFirstChild("HumanoidRootPart")
                if eHRP then
                    local dist = (hrp.Position - eHRP.Position).Magnitude
                    if dist < searchRadius then
                        local name = enemyModel.Name
                        for _, kw in ipairs(SEA3_NPCS) do
                            if name:lower():find(kw:lower()) then
                                return 3, name
                            end
                        end
                        for _, kw in ipairs(SEA2_NPCS) do
                            if name:lower():find(kw:lower()) then
                                return 2, name
                            end
                        end
                    end
                end
            end
        end
    end
    return nil, nil
end

-- ================================================================
-- EN YAKIN DÜŞMAN NPC'Yİ BUL
-- ================================================================

local function findNearestEnemy()
    local hrp = getHRP()
    if not hrp then return nil end

    local closest = nil
    local closestDist = math.huge
    local searchRadius = 200

    local sea, _ = detectSea()

    local targetKeywords = {}
    if sea == 2 then
        targetKeywords = SEA2_NPCS
    elseif sea == 3 then
        targetKeywords = SEA3_NPCS
    else
        -- İki denizin keyword'lerini birleştir
        for _, v in ipairs(SEA2_NPCS) do table.insert(targetKeywords, v) end
        for _, v in ipairs(SEA3_NPCS) do table.insert(targetKeywords, v) end
    end

    for _, desc in pairs(workspace:GetDescendants()) do
        if desc:IsA("Humanoid") and desc.Health > 0 and desc.Parent ~= getCharacter() then
            local enemyModel = desc.Parent
            local eHRP = enemyModel and enemyModel:FindFirstChild("HumanoidRootPart")
            if eHRP then
                local dist = (hrp.Position - eHRP.Position).Magnitude
                if dist < closestDist and dist < searchRadius then
                    local name = enemyModel.Name
                    for _, kw in ipairs(targetKeywords) do
                        if name:lower():find(kw:lower()) then
                            closest     = {model = enemyModel, humanoid = desc, hrp = eHRP}
                            closestDist = dist
                            break
                        end
                    end
                end
            end
        end
    end

    return closest
end

-- ================================================================
-- NPC'YE GİT (basit teleport + pathfind fallback)
-- ================================================================

local function moveToNPC(targetHRP, maxWait)
    local hum = getHumanoid()
    local hrp = getHRP()
    if not hum or not hrp or not targetHRP then return end

    maxWait = maxWait or 5
    hum:MoveTo(targetHRP.Position + Vector3.new(0, 0, 4))

    local t = 0
    while t < maxWait do
        if (hrp.Position - targetHRP.Position).Magnitude < 8 then break end
        task.wait(0.1)
        t = t + 0.1
    end

    -- Hâlâ uzaksa kısa teleport
    if (hrp.Position - targetHRP.Position).Magnitude > 15 then
        hrp.CFrame = CFrame.new(targetHRP.Position + Vector3.new(0, 0, 5))
    end
end

-- ================================================================
-- ANA DESTEK DÖNGÜSÜ
-- ================================================================

local masteryRunning = false
local selectedMeleeStyle = nil  -- kullanıcının seçtiği fighting style (string)
local selectedGunName   = nil   -- kullanıcının seçtiği gun (string)

local function masteryLoop()
    while masteryRunning do
        -- Denizi kontrol et
        local sea, seaNPC = detectSea()
        if not sea then
            task.wait(2)
            continue
        end

        -- Hedef NPC bul
        local enemy = findNearestEnemy()
        if not enemy or not enemy.humanoid or enemy.humanoid.Health <= 0 then
            task.wait(1)
            continue
        end

        local npcHumanoid = enemy.humanoid
        local npcHRP      = enemy.hrp
        local npcMaxHP    = npcHumanoid.MaxHealth

        -- NPC'ye yürü / yaklaş
        moveToNPC(npcHRP, 4)
        if not masteryRunning then break end

        -- ---- FAZA 1: MELEE ile %90 HP eritme ----
        local meleeEquipped = equipMelee(selectedMeleeStyle)
        if not meleeEquipped then
            warn("[TRGojo] Melee/Fighting Style bulunamadı! Backpack'ini kontrol et.")
            task.wait(2)
            continue
        end

        local switchThreshold = npcMaxHP * 0.10  -- %10 HP kala gun'a geç

        while masteryRunning
            and npcHumanoid
            and npcHumanoid.Health > switchThreshold do

            -- NPC hâlâ hayatta mı?
            if npcHumanoid.Health <= 0 then break end

            faceTarget(npcHRP)
            moveToNPC(npcHRP, 0.3)
            doM1()
            task.wait(0.18)  -- BF M1 cooldown yaklaşık
        end

        if not masteryRunning then break end
        if npcHumanoid.Health <= 0 then
            task.wait(0.5)
            continue  -- NPC öldü, yenisini bul
        end

        -- ---- FAZA 2: GUN ile son %10 — MASTERİ BURAYA GELİR ----
        local gunEquipped = equipGun(selectedGunName)
        if not gunEquipped then
            warn("[TRGojo] Gun bulunamadı! Silahını character'a al.")
            task.wait(2)
            continue
        end

        while masteryRunning
            and npcHumanoid
            and npcHumanoid.Health > 0 do

            faceTarget(npcHRP)
            moveToNPC(npcHRP, 0.3)
            doM1()
            task.wait(0.22)  -- Gun M1 biraz daha yavaş
        end

        task.wait(0.4)  -- kısa nefes, spawn bekle
    end
end

